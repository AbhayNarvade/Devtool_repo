{
  "name": "devtool-site",
  "version": "1.0.0",
  "private": true,
  "description": "Free online tools that run 100% in your browser. Static Next.js site for Cloudflare Pages.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run assets && next dev",
    "assets": "tsx scripts/generate-assets.ts",
    "prebuild": "npm run assets",
    "build": "next build",
    "preview": "tsx scripts/serve-out.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:seo": "tsx scripts/check-seo.ts",
    "test:browser": "tsx scripts/browser-smoke.ts"
  },
  "dependencies": {
    "js-yaml": "5.5.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.7",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "node-html-parser": "9.0.7",
    "prettier": "3.10.1",
    "satori": "0.63.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
