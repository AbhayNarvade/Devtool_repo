# Production URL (https://domain, no trailing slash, no www).
# Leave empty to use https://<DOMAIN> from src/config/site.ts, so renaming the domain needs no env change.
# Set it only for special cases such as a staging deployment on another hostname.
NEXT_PUBLIC_SITE_URL=
# AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX (leave empty to disable all ads)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional)
NEXT_PUBLIC_GA_ID=
# Formspree form ID for the contact form (optional; without it only the email link is shown)
NEXT_PUBLIC_FORMSPREE_ID=
